# School ERP - Apache configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Block access to sensitive files
<FilesMatch "\.(sql|log|ini|lock|md|bak|env|json)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|storage|database|uploads)(/|$) - [F,L]
</IfModule>
